# GoHighLevel (Settings → Private Integrations). Token starts with pit-. The 10 scopes it needs are listed in docs/setup.md.
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
# The calendar patients book into. No-shows from other calendars are ignored.
GHL_CALENDAR_ID=your-calendar-id
# The opportunity pipeline, and the stages a no-show and a rebooked patient move to.
GHL_PIPELINE_ID=your-pipeline-id
GHL_NO_SHOW_STAGE_ID=your-no-show-stage-id
GHL_REBOOKED_STAGE_ID=your-rebooked-stage-id
# Optional: the number texts go out from. Leave empty to use the location's default number.
GHL_FROM_NUMBER=
# Optional: your white label app domain, used for contact links in Slack
GHL_APP_URL=https://app.gohighlevel.com

# Shared secret for both webhooks. Make up a long random string (at least 16 characters, for example openssl rand -hex 32)
# and put the same value in the Bearer Token of the Custom Webhook actions in GoHighLevel (see ghl/native-workflows.md).
# An empty value refuses every call, and the example value below is refused as a broken setting.
GHL_WEBHOOK_SECRET=make-up-a-long-random-string

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. claude-haiku-4-5 is cheaper, claude-opus-5 also works. Replies use a forced tool
# call with thinking off, so claude-opus-5-5 and the Claude Fable and Mythos models do not work (the webhooks refuse
# to start with them and name the problem).
ANTHROPIC_MODEL=claude-sonnet-5

# The business, as the texts and the agent describe it
BUSINESS_NAME=Harbor Physio Clinic
BUSINESS_ABOUT=a physiotherapy clinic
# What the texts call the visit ("We missed you at your physio appointment today at 9:00 AM")
VISIT_NAME=physio appointment
# Optional. Empty means the texts never mention fees. When set, this sentence is added to the first text after a no-show.
NO_SHOW_POLICY_TEXT=

# Prefix for the tags the agent adds (no-show, no-show-rebooked, no-show-agent-booked, and so on).
# The GoHighLevel workflows filter on these names, so change them there too.
TAG_PREFIX=no-show
# true: offer and book times with the same team member as the missed visit (when the visit had one)
SAME_STAFF=true
# How far ahead to look for open times (days, at most 30)
SLOT_SEARCH_DAYS=7

# Texts only go out between these hours in the patient's own time zone (BUSINESS_TZ when the contact has none).
# Outside them the agent still reads replies and books, and its text waits for the morning.
SEND_HOUR_START=9
SEND_HOUR_END=19
BUSINESS_TZ=America/New_York

# Follow-ups for patients who never answer: up to two, in hours after the first text. Empty means no follow-ups.
FOLLOW_UP_HOURS=24,72
# Hours after the first text (or after the last message, if they answered once) when a silent conversation is closed
CLOSE_AFTER_HOURS=120
# Agent replies per patient before a person takes over
MAX_AI_REPLIES=4

# Optional: Slack incoming webhook for rebookings, hand offs, the daily summary and error alerts. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
